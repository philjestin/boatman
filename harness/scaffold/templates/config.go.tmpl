package main

import (
	"os"
	"strings"
)

// AppConfig holds runtime configuration for this agent.
type AppConfig struct {
	// MaxIterations is the maximum number of review/refactor cycles.
	MaxIterations int

	// ProjectLang is the language of the target project (e.g. "go", "python").
	ProjectLang string

	// ReviewCriteria is an optional description of what the reviewer should focus on.
	ReviewCriteria string

	// Model is the default model for every role when a role-specific model is not set.
	Model string

	// PlanModel is used by the optional planner.
	PlanModel string

	// ImplementationModel is used by Execute and Refactor.
	ImplementationModel string

	// SkillsModel is used by skill/review execution.
	SkillsModel string
}

// LoadConfig returns the application configuration.
func LoadConfig() AppConfig {
	defaultModel := strings.TrimSpace(os.Getenv("HARNESS_MODEL"))
	return AppConfig{
		MaxIterations:       {{.MaxIterations}},
		ProjectLang:         "{{.ProjectLang}}",
		ReviewCriteria:      "{{.ReviewCriteria}}",
		Model:               defaultModel,
		PlanModel:           modelOrDefault("HARNESS_PLAN_MODEL", defaultModel),
		ImplementationModel: modelOrDefault("HARNESS_IMPLEMENTATION_MODEL", defaultModel),
		SkillsModel:         modelOrDefault("HARNESS_SKILLS_MODEL", defaultModel),
	}
}

func modelOrDefault(envKey, fallback string) string {
	if value := strings.TrimSpace(os.Getenv(envKey)); value != "" {
		return value
	}
	return fallback
}
